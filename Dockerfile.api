FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY migrations ./migrations
COPY alembic.ini ./

RUN pip install --upgrade pip && pip install --no-cache-dir -e .

EXPOSE 8001

CMD ["python", "-m", "uvicorn", "fleetops.services.api.main:app", "--host", "0.0.0.0", "--port", "8001"]
